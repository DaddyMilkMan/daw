## 🎨 CODE STYLE

```cpp
// Naming
class MyClass { };           // PascalCase for classes
void doSomething();          // camelCase for methods
int frameCount_;             // camelCase + trailing _ for members
constexpr int MAX_SIZE{100}; // UPPER_CASE for constants

// Modern C++20
auto value = getValue();              // ✅ auto when type is obvious
std::unique_ptr<T> ptr{nullptr};     // ✅ {} initialization
if (auto* p = getPointer(); p) { }   // ✅ Init-statement in if

// Error Handling
if (!success) {
    jassertfalse;  // Debug assertion
    DBG("Error: " << details);  // Log to console
    return false;  // Propagate error
}

// Comments
// Explain WHY, not WHAT
// GOOD: "Recreate surface on resize (Wayland requirement)"
// BAD:  "Set width and height"

// File Organization
class MyClass {
public:
    // Public interface first
    
private:
    // Private implementation last
    
    JUCE_DECLARE_NON_COPYABLE_WITH_LEAK_DETECTOR(MyClass)
};
