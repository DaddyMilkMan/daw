## ❌ ANTI-PATTERNS (INSTANT FAILURE)

```cpp
// 1. AUDIO THREAD VIOLATIONS
void audioCallback(float** output, int numSamples) {
    std::vector<float> buffer;         // ❌ ALLOCATION
    mutex.lock();                      // ❌ LOCK
    std::cout << "audio";              // ❌ I/O
    projectState.getRoot();            // ❌ ValueTree access
}

// 2. MEMORY LEAKS
void createRenderer() {
    auto* renderer = new SkiaRenderer();  // ❌ RAW POINTER
    // Never deleted = leak
}

// 3. WAYLAND UNSAFE
void render() {
    static GLuint fbo = /* cached */;     // ❌ CACHED FBO
    // Context can be lost, this will crash
}

// 4. HARDCODED VALUES
canvas->clear(SkColorSetARGB(255, 26, 26, 31));  // ❌ MAGIC NUMBERS

// 5. STUB IMPLEMENTATIONS
void importantMethod() {
    // TODO: implement later                // ❌ STUB
}

// 6. MISSING ERROR HANDLING
auto file = juce::File::openRead(path);         // ❌ NO CHECK
// What if file doesn't exist?

// 7. UNINITIALIZED VARIABLES
int frameCount;                                  // ❌ UNINITIALIZED
// Use: int frameCount{0};

// 8. JUCE GRAPHICS IN NEW CODE
void paint(juce::Graphics& g) {
    g.fillAll(juce::Colours::black);     // ❌ Use Skia instead
}

// 9. BLOCKING UI THREAD
void buttonClicked() {
    auto data = loadFromDisk();          // ❌ I/O on UI thread
    // Use background thread instead
}

// 10. DIRECT AUDIO THREAD UPDATES
void sliderChanged(float value) {
    audioEngine.setVolume(value);        // ❌ No thread safety
    // Use atomic instead
}
```

