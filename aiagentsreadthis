## ✅ CORRECT PATTERNS

```cpp
// 1. AUDIO THREAD SAFE
class AudioEngine {
    std::atomic<double> tempo_{120.0};
    std::vector<float> preallocatedBuffer_;  // Pre-allocated
    
    void audioCallback(float** output, int numSamples) {
        double t = tempo_.load();  // ✅ Atomic read
        // Use preallocatedBuffer_ (no allocation)
    }
};

// 2. MEMORY SAFE
void createRenderer() {
    auto renderer = std::make_unique<SkiaRenderer>();  // ✅ Smart pointer
    // Automatically deleted
}

// 3. WAYLAND SAFE
void render() {
    GLint fbo;
    glGetIntegerv(GL_FRAMEBUFFER_BINDING, &fbo);  // ✅ Query every frame
}

// 4. NAMED CONSTANTS
namespace Theme {
    constexpr SkColor Background{0xFF1A1A1F};  // ✅ Named constant
}
canvas->clear(Theme::Background);

// 5. COMPLETE IMPLEMENTATION
void importantMethod() {
    // ✅ Full implementation with error handling
    if (!initialize()) {
        jassertfalse;
        DBG("Failed to initialize: " << getLastError());
        return;
    }
    // ... complete logic
}

// 6. ERROR HANDLING
auto file = juce::File::openRead(path);
if (!file.exists()) {
    DBG("File not found: " << path);
    return false;
}
// ✅ Checked before use

// 7. INITIALIZED VARIABLES
int frameCount{0};           // ✅ Initialized
float volume{0.8f};          // ✅ Initialized
bool isReady{false};         // ✅ Initialized

// 8. SKIA RENDERING
void render(SkCanvas* canvas) {
    canvas->clear(Theme::Background);    // ✅ Skia
}

// 9. NON-BLOCKING UI
void buttonClicked() {
    std::thread([this]() {
        auto data = loadFromDisk();
        juce::MessageManager::callAsync([data]() {
            updateUI(data);  // ✅ Back to UI thread
        });
    }).detach();
}

// 10. THREAD-SAFE AUDIO UPDATES
void sliderChanged(float value) {
    volumeAtomic_.store(value);          // ✅ Atomic write
    // Audio thread reads volumeAtomic_.load()
}
```

