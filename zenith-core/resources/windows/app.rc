// Zenith DAW - Windows Resource Script
// Links the application manifest into the executable

#include <windows.h>

// Embed the application manifest
1 RT_MANIFEST "app.manifest"

// Version information
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ZenithAudio"
            VALUE "FileDescription", "Zenith DAW"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "ZenithDAW"
            VALUE "LegalCopyright", "Copyright (C) 2025 ZenithAudio"
            VALUE "OriginalFilename", "ZenithDAW.exe"
            VALUE "ProductName", "Zenith DAW"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Icon (placeholder - will add actual icon later)
// IDI_ICON1 ICON "zenith.ico"
