# --- The Citadel Strict Ignore Policy ---
# Combined comprehensive .gitignore for Zenith DAW

# ============================================
# 1. Build Artifacts (Aggressive)
# ============================================
/build*/
build/
/out/
/bin/
/lib/
/obj/
/Debug/
/Release/
/_deps/
_deps/
cmake-build-*/
.cache/
**/CMakeFiles/
CMakeFiles/
**/cmake_install.cmake
cmake_install.cmake
CMakeCache.txt
compile_commands.json
Testing/
build_output*.txt

# Build logs
build_fix*/
build_manual/
build_skia/
build_trash/
modules/*/build/

# Logs Directory
/logs/

# ============================================
