# --- The Citadel Strict Ignore Policy ---
# Combined comprehensive .gitignore for Zenith DAW

# ============================================
# 1. Build Artifacts (Aggressive)
# ============================================
/build*/
build/
/out/
/bin/
/lib/
/obj/
/Debug/
/Release/
/_deps/
_deps/
cmake-build-*/
.cache/
**/CMakeFiles/
CMakeFiles/
**/cmake_install.cmake
cmake_install.cmake
CMakeCache.txt
compile_commands.json
Testing/
build_output*.txt

# Build logs
build_fix*/
build_manual/
build_skia/
build_trash/
modules/*/build/

# Logs Directory
/logs/

# ============================================
# 2. Compiled Binaries
# ============================================
*.so
*.a
*.lib
*.dll
*.exe
*.o
*.obj
*.pch
pch.h.gch

# ============================================
# 3. OS Junk
# ============================================
.DS_Store
Thumbs.db
Desktop.ini

# ============================================
# 4. IDE Clutter
# ============================================
.vscode/
.idea/
*.sln
*.vcxproj
*.vcxproj.user
*.vcxproj.filters
*.swp
*.swo
*.code-workspace
.clangd

# ============================================
# 5. Local Environment
# ============================================
.env
*.local
.venv/

# ============================================
# 6. Node Dependencies
# ============================================
node_modules/
npm-debug.log

# ============================================
# 7. Build Logs and Error Files
# ============================================
*.log
build_errors*.txt
build_error*.txt
build_log*.txt
build_verbose.txt
build_tree.txt
cmake_error*.log
msbuild_*.log
debug_log.txt
daw_gui_log*.txt
output.txt
server_log.txt

# ============================================
# 8. Backup and Temporary Files
# ============================================
*.bak
*.old
*.tmp
*.backup
*.orig
*~

# ============================================
# 9. Python Artifacts
# ============================================
*.pyc
__pycache__/
*.pyo
*.pyd
.Python

# Local Python venv for tools/mcp_server
/tools/mcp_server/venv/

# MCP runtime snapshot and generated assets
/tools/mcp_server/engine_snapshot.json
# Allow configuring engine snapshot path via environment, ignore user overrides
/.mcp_engine_snapshot_override

/tools/mcp_server/*.png
/tools/mcp_server/*.wav
/tools/mcp_server/*.log

# ============================================
# 10. Script and Patch Files
# ============================================
*.ps1
*.patch

# ============================================
# 11. Images in Root (stray artifacts)
# ============================================
/*.png
/*.jpg
/*.gif

# ============================================
# 12. Zenith DAW Specific Transients
# ============================================
/final_test_results*.txt
/test_critic_fix.txt
/test_debug.txt
/test_final*.txt
/test_manual.txt
/test_output*.txt
/test_results.txt
/sync_log.txt
/session_debug_log.txt
/leak_traces.txt
/all_linked_objects.txt
/linked_objects.txt
/obj_list.txt
/apps/desktop/Source/zenith_headers.txt
/launch.sh
/apps/scanner/
/old_logs/

# ============================================
# 13. Archived Documentation (historical)
# ============================================
/docs/archive/root-cleanup-*/

# ============================================
# 13. Text Files (except CMakeLists)
# ============================================
*.txt
!CMakeLists.txt
!**/CMakeLists.txt
!README.txt
!LICENSE.txt
!docs/**/*.txt
.venv/
checkpoints/
AliasingFFTBenchmark
CompleteVoiceBenchmark
PluginScanner
SynthPerformanceBenchmark
ZenithTests
*_artefacts/

# Zig build artifacts
.zig-cache/
zig-out/
