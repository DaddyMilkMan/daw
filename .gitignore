# --- The Citadel Strict Ignore Policy ---

# 1. Build Artifacts (Aggressive)
/build*/
/out/
/bin/
/lib/
cmake-build-*/
.cache/
**/CMakeFiles/
**/cmake_install.cmake
*.vcxproj.filters
build_output*.txt

# 1b. Logs Directory
/logs/

# 1c. Leftover & Nested Build Folders
build_fix*/
build_manual/
build_skia/
build_trash/
modules/*/build/

# 2. OS Junk
.DS_Store
Thumbs.db
Desktop.ini

# 3. IDE Clutter
.vscode/
.idea/
*.sln
*.vcxproj
*.vcxproj.user

# 4. Node Dependencies
node_modules/
npm-debug.log

# 5. Local Env
.env
*.local

# 6. Build Logs and Error Files
build_errors*.txt
build_log*.txt
build_verbose.txt
cmake_error*.log
msbuild_*.log
*.log
debug_log.txt
daw_gui_log*.txt
build_tree.txt
unicode_chars.txt
COMPLETION_SUMMARY.txt

# 7. Backup Files
*.bak
*.old
*.tmp
*.backup
*.orig

# 8. Python Artifacts
*.pyc
__pycache__/
*.pyo
*.pyd
.Python

# 9. Images in root (stray artifacts)
/*.png
/*.jpg
/*.gif

