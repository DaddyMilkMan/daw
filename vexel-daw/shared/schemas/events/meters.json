{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zenith-daw.com/schemas/events/meters.json",
  "title": "Metering Events",
  "description": "Events related to audio level metering",
  "definitions": {
    "MeterValues": {
      "type": "object",
      "properties": {
        "peak": {
          "type": "array",
          "description": "Peak values in dB per channel",
          "items": {
            "type": "number",
            "minimum": -120,
            "maximum": 12
          },
          "minItems": 1,
          "maxItems": 8
        },
        "rms": {
          "type": "array",
          "description": "RMS values in dB per channel",
          "items": {
            "type": "number",
            "minimum": -120,
            "maximum": 12
          },
          "minItems": 1,
          "maxItems": 8
        }
      },
      "required": ["peak", "rms"]
    },
    "MetersEvent": {
      "type": "object",
      "title": "Meters Event",
      "description": "Audio level meters update (high frequency)",
      "properties": {
        "type": {
          "type": "string",
          "const": "meters"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object",
          "properties": {
            "tracks": {
              "type": "object",
              "description": "Meter values per track",
              "additionalProperties": {
                "$ref": "#/definitions/MeterValues"
              }
            },
            "master": {
              "$ref": "#/definitions/MeterValues",
              "description": "Master bus meter values"
            }
          },
          "required": ["tracks", "master"]
        }
      },
      "required": ["type", "timestamp", "data"],
      "additionalProperties": false
    }
  }
}
