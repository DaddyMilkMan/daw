{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zenith-daw.com/schemas/events/track.json",
  "title": "Track Events",
  "description": "Events related to track state changes",
  "definitions": {
    "TrackAddedEvent": {
      "type": "object",
      "title": "Track Added Event",
      "description": "New track created",
      "properties": {
        "type": {
          "type": "string",
          "const": "track_added"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object",
          "properties": {
            "track": {
              "type": "object",
              "description": "Full Track object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "name": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": ["audio", "midi", "instrument", "bus", "master"]
                }
              },
              "required": ["id", "name", "type"]
            }
          },
          "required": ["track"]
        }
      },
      "required": ["type", "timestamp", "data"],
      "additionalProperties": false
    },
    "TrackUpdatedEvent": {
      "type": "object",
      "title": "Track Updated Event",
      "description": "Track properties changed",
      "properties": {
        "type": {
          "type": "string",
          "const": "track_updated"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object",
          "properties": {
            "trackId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "changes": {
              "type": "object",
              "description": "Changed properties",
              "minProperties": 1
            }
          },
          "required": ["trackId", "changes"]
        }
      },
      "required": ["type", "timestamp", "data"],
      "additionalProperties": false
    },
    "TrackRemovedEvent": {
      "type": "object",
      "title": "Track Removed Event",
      "description": "Track deleted",
      "properties": {
        "type": {
          "type": "string",
          "const": "track_removed"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "data": {
          "type": "object",
          "properties": {
            "trackId": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "required": ["trackId"]
        }
      },
      "required": ["type", "timestamp", "data"],
      "additionalProperties": false
    }
  }
}
