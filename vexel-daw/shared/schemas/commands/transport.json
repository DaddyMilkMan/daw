{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zenith-daw.com/schemas/commands/transport.json",
  "title": "Transport Commands",
  "description": "Commands for controlling DAW transport (playback, recording, position)",
  "definitions": {
    "TransportPlayCommand": {
      "type": "object",
      "title": "Transport Play Command",
      "description": "Start playback from current position",
      "properties": {
        "command": {
          "type": "string",
          "const": "transport_play"
        },
        "params": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "required": ["command", "params"],
      "additionalProperties": false
    },
    "TransportStopCommand": {
      "type": "object",
      "title": "Transport Stop Command",
      "description": "Stop playback",
      "properties": {
        "command": {
          "type": "string",
          "const": "transport_stop"
        },
        "params": {
          "type": "object",
          "properties": {
            "returnToStart": {
              "type": "boolean",
              "description": "If true, reset playhead to 0",
              "default": false
            }
          },
          "additionalProperties": false
        }
      },
      "required": ["command", "params"],
      "additionalProperties": false
    },
    "TransportSetPositionCommand": {
      "type": "object",
      "title": "Transport Set Position Command",
      "description": "Move playhead to specific position",
      "properties": {
        "command": {
          "type": "string",
          "const": "transport_set_position"
        },
        "params": {
          "type": "object",
          "properties": {
            "beat": {
              "type": "number",
              "description": "Position in beats",
              "minimum": 0
            }
          },
          "required": ["beat"],
          "additionalProperties": false
        }
      },
      "required": ["command", "params"],
      "additionalProperties": false
    },
    "TransportRecordCommand": {
      "type": "object",
      "title": "Transport Record Command",
      "description": "Start recording on armed tracks",
      "properties": {
        "command": {
          "type": "string",
          "const": "transport_record"
        },
        "params": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "required": ["command", "params"],
      "additionalProperties": false
    },
    "SetTempoCommand": {
      "type": "object",
      "title": "Set Tempo Command",
      "description": "Change global tempo",
      "properties": {
        "command": {
          "type": "string",
          "const": "set_tempo"
        },
        "params": {
          "type": "object",
          "properties": {
            "tempo": {
              "type": "number",
              "description": "Tempo in BPM",
              "minimum": 1,
              "maximum": 999
            },
            "beat": {
              "type": "number",
              "description": "Position for tempo change (optional)",
              "minimum": 0
            }
          },
          "required": ["tempo"],
          "additionalProperties": false
        }
      },
      "required": ["command", "params"],
      "additionalProperties": false
    },
    "SetTimeSignatureCommand": {
      "type": "object",
      "title": "Set Time Signature Command",
      "description": "Change time signature",
      "properties": {
        "command": {
          "type": "string",
          "const": "set_time_signature"
        },
        "params": {
          "type": "object",
          "properties": {
            "numerator": {
              "type": "integer",
              "description": "Beats per bar",
              "minimum": 1,
              "maximum": 64
            },
            "denominator": {
              "type": "integer",
              "description": "Note value",
              "enum": [1, 2, 4, 8, 16, 32]
            },
            "beat": {
              "type": "number",
              "description": "Position for change (optional)",
              "minimum": 0
            }
          },
          "required": ["numerator", "denominator"],
          "additionalProperties": false
        }
      },
      "required": ["command", "params"],
      "additionalProperties": false
    }
  }
}
