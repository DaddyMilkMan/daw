{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://zenith-daw.com/schemas/commands/plugin.json",
  "title": "Plugin Commands",
  "description": "Commands for plugin management",
  "definitions": {
    "InsertPluginCommand": {
      "type": "object",
      "title": "Insert Plugin Command",
      "description": "Add a plugin to a track",
      "properties": {
        "command": {
          "type": "string",
          "const": "insert_plugin"
        },
        "params": {
          "type": "object",
          "properties": {
            "trackId": {
              "type": "string",
              "description": "Parent track UUID",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "pluginId": {
              "type": "string",
              "description": "Plugin identifier"
            },
            "position": {
              "type": "integer",
              "description": "Slot position (optional)",
              "minimum": 0
            }
          },
          "required": ["trackId", "pluginId"],
          "additionalProperties": false
        }
      },
      "required": ["command", "params"],
      "additionalProperties": false
    },
    "RemovePluginCommand": {
      "type": "object",
      "title": "Remove Plugin Command",
      "description": "Remove a plugin from a track",
      "properties": {
        "command": {
          "type": "string",
          "const": "remove_plugin"
        },
        "params": {
          "type": "object",
          "properties": {
            "trackId": {
              "type": "string",
              "description": "Parent track UUID",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "pluginSlotId": {
              "type": "string",
              "description": "Plugin slot UUID",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "required": ["trackId", "pluginSlotId"],
          "additionalProperties": false
        }
      },
      "required": ["command", "params"],
      "additionalProperties": false
    },
    "SetPluginParamCommand": {
      "type": "object",
      "title": "Set Plugin Parameter Command",
      "description": "Change a plugin parameter value",
      "properties": {
        "command": {
          "type": "string",
          "const": "set_plugin_param"
        },
        "params": {
          "type": "object",
          "properties": {
            "pluginSlotId": {
              "type": "string",
              "description": "Plugin slot UUID",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "parameterId": {
              "type": "string",
              "description": "Plugin-specific parameter ID"
            },
            "value": {
              "type": "number",
              "description": "Normalized value",
              "minimum": 0.0,
              "maximum": 1.0
            }
          },
          "required": ["pluginSlotId", "parameterId", "value"],
          "additionalProperties": false
        }
      },
      "required": ["command", "params"],
      "additionalProperties": false
    }
  }
}
