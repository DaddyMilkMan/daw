{
  "name": "vexel-daw",
  "version": "0.1.0",
  "description": "Vexel - AI-Native Digital Audio Workstation with Wingman Integration",
  "main": "src/main/index.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on tcp:5173 && electron .\"",
    "dev:vite": "vite",
    "dev:electron": "NODE_ENV=development electron .",
    "build": "vite build",
    "build:app": "npm run build && electron-builder",
    "build:schemas": "node scripts/build-schemas.js",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "keywords": [
    "daw",
    "music",
    "ai",
    "audio",
    "midi",
    "wingman"
  ],
  "author": "DaddyMilkMan",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.928.0",
    "@aws-sdk/lib-storage": "^3.928.0",
    "@magenta/music": "^1.23.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.1",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-scroll-area": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.0",
    "@radix-ui/react-toast": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.1.4",
    "@tensorflow/tfjs": "^4.22.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.0",
    "framer-motion": "^11.0.0",
    "idb": "^8.0.0",
    "lucide-react": "^0.462.0",
    "react": "^18.3.1",
    "react-colorful": "^5.6.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.0.3",
    "ws": "^8.18.0",
    "y-webrtc": "^10.2.5",
    "yjs": "^13.6.11",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.13.3",
    "glob": "^10.3.10",
    "json-schema-to-typescript": "^13.1.2",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "vite": "^5.4.1",
    "wait-on": "^7.2.0"
  },
  "optionalDependencies": {
    "megajs": "^1.1.1",
    "pcloud-sdk-js": "^1.4.0"
  },
  "build": {
    "appId": "com.daddymilkman.vexel",
    "productName": "Vexel DAW",
    "directories": {
      "output": "dist-electron",
      "buildResources": "build"
    },
    "files": [
      "src/main/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Audio;AudioVideo;Music"
    }
  }
}
