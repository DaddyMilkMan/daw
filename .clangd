# or to override/supplement its settings

CompileFlags:
  Add:
    # C++ Standard
    - "-std=c++20"
    
    # JUCE Headers (from build/_deps/juce-src)
    - "-Ic:/zenith/daw/build/_deps/juce-src/modules"
    
    # JUCE Generated Headers
    - "-Ic:/zenith/daw/build/ZenithDAW_artefacts"
    - "-Ic:/zenith/daw/build/JuceLibraryCode"
    - "-Ic:/zenith/daw/build/ZenithDAW_artefacts/JuceLibraryCode"
    
    # Skia Headers (from sibling skia folder)
    - "-Ic:/zenith/skia/include"
    - "-Ic:/zenith/skia/include/core"
    - "-Ic:/zenith/skia/include/effects"
    - "-Ic:/zenith/skia/include/gpu"
    - "-Ic:/zenith/skia"
    
    # Project Include Directories
    - "-Ic:/zenith/daw/apps/desktop/include"
    - "-Ic:/zenith/daw/apps/desktop/Source"
    - "-Ic:/zenith/daw/apps/desktop/Source/ui/skia"
    
    # JUCE Compile Definitions
    - "-DJUCE_GLOBAL_MODULE_SETTINGS_INCLUDED=1"
    - "-DJUCE_WEB_BROWSER=0"
    - "-DJUCE_USE_CURL=0"
    - "-DJUCE_VST3_CAN_REPLACE_VST2=0"
    - "-DJUCE_DISPLAY_SPLASH_SCREEN=0"
    - "-DJUCE_REPORT_APP_USAGE=0"
    - "-DJUCE_APPLICATION_NAME_STRING=\"ZenithDAW\""
    - "-DJUCE_APPLICATION_VERSION_STRING=\"0.1.0\""
    - "-DJUCE_MODULE_AVAILABLE_juce_audio_basics=1"
    - "-DJUCE_MODULE_AVAILABLE_juce_audio_devices=1"
    - "-DJUCE_MODULE_AVAILABLE_juce_audio_formats=1"
    - "-DJUCE_MODULE_AVAILABLE_juce_audio_processors=1"
    - "-DJUCE_MODULE_AVAILABLE_juce_audio_utils=1"
    - "-DJUCE_MODULE_AVAILABLE_juce_core=1"
    - "-DJUCE_MODULE_AVAILABLE_juce_data_structures=1"
    - "-DJUCE_MODULE_AVAILABLE_juce_dsp=1"
    - "-DJUCE_MODULE_AVAILABLE_juce_events=1"
    - "-DJUCE_MODULE_AVAILABLE_juce_graphics=1"
    - "-DJUCE_MODULE_AVAILABLE_juce_gui_basics=1"
    - "-DJUCE_MODULE_AVAILABLE_juce_gui_extra=1"
    - "-DJUCE_MODULE_AVAILABLE_juce_opengl=1"
    
    # Skia compile definitions
    - "-DZENITH_USE_SKIA=1"
    - "-DSK_GL=1"
    
    # Windows platform defines
    - "-D_WIN32"
    - "-DWIN32"
    - "-D_WINDOWS"
    - "-DNOMINMAX"
    - "-D_UNICODE"
    - "-DUNICODE"
    
  # Remove problematic flags that may conflict
  Remove:
    - "-W*"

Diagnostics:
  # Reduce noise from external headers
  Suppress:
    - "misc-non-private-member-variables-in-classes"
    - "modernize-use-trailing-return-type"
    - "readability-identifier-length"
    
  ClangTidy:
    Remove:
      - misc-no-recursion
      - modernize-use-trailing-return-type

InlayHints:
  Enabled: true
  ParameterNames: true
  DeducedTypes: true

Index:
  Background: Build
