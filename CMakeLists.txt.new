# ============================================================================
# Zenith DAW - Professional Digital Audio Workstation
# ============================================================================
# Unified build system replacing fragmented Makefiles

cmake_minimum_required(VERSION 3.22)

project(ZenithDAW
    VERSION 1.0.0
    DESCRIPTION "Professional Digital Audio Workstation"
    LANGUAGES CXX C
)

# ============================================================================
# Build Configuration
# ============================================================================

set(CMAKE_CXX_STANDARD 20)
set(CMAKE_CXX_STANDARD_REQUIRED ON)
set(CMAKE_CXX_EXTENSIONS OFF)
set(CMAKE_EXPORT_COMPILE_COMMANDS ON)

# Default to Release build
if(NOT CMAKE_BUILD_TYPE)
    set(CMAKE_BUILD_TYPE Release CACHE STRING "Build type" FORCE)
endif()

# ============================================================================
# Output Directories (keeps build artifacts contained)
# ============================================================================

set(CMAKE_RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin)
set(CMAKE_LIBRARY_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/lib)
set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/lib)

# ============================================================================
# Options
# ============================================================================

option(VEXEL_BUILD_TESTS "Build unit tests" ON)
option(VEXEL_BUILD_PLUGINS "Build example plugins" ON)
option(VEXEL_ENABLE_LUA "Enable Lua scripting" ON)
option(VEXEL_BUILD_WEBUI "Build auxiliary web UI modules" OFF)

# ============================================================================
# CMake Modules
# ============================================================================

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake")

include(AudioDrivers)
include(JUCEConfig)

# ============================================================================
# Third-Party Dependencies
# ============================================================================

# Lua for scripting
if(VEXEL_ENABLE_LUA)
    find_package(Lua 5.4)
    if(NOT LUA_FOUND)
        message(STATUS "Lua not found, fetching...")
        include(FetchContent)
        FetchContent_Declare(
            lua
            URL https://www.lua.org/ftp/lua-5.4.6.tar.gz
            URL_HASH SHA256=7d5ea1b9cb6aa0b59ca3dde1c6adcb57ef83a1ba8e5432c0ecd06bf439b3ad88
        )
        FetchContent_MakeAvailable(lua)
    endif()
endif()

# ============================================================================
# Core Audio Engine Library
# ============================================================================

add_subdirectory(src/audio)

# ============================================================================
# Native UI (JUCE-based)
# ============================================================================

add_subdirectory(src/ui)

# ============================================================================
# Web UI (Optional TypeScript/React auxiliary modules)
# ============================================================================

if(VEXEL_BUILD_WEBUI)
    add_subdirectory(src/webui)
endif()

# ============================================================================
# Scripting Layer
# ============================================================================

if(VEXEL_ENABLE_LUA)
    add_subdirectory(scripts)
endif()

# ============================================================================
# Unit Tests
# ============================================================================

if(VEXEL_BUILD_TESTS)
    enable_testing()
    add_subdirectory(tests)
endif()

# ============================================================================
# Configuration Summary
# ============================================================================

zenith_print_audio_config()

message(STATUS "")
message(STATUS "═══════════════════════════════════════")
message(STATUS "Zenith DAW Build Configuration")
message(STATUS "═══════════════════════════════════════")
message(STATUS "Version:        ${PROJECT_VERSION}")
message(STATUS "Build Type:     ${CMAKE_BUILD_TYPE}")
message(STATUS "C++ Standard:   C++${CMAKE_CXX_STANDARD}")
message(STATUS "")
message(STATUS "Features:")
message(STATUS "  Tests:        ${VEXEL_BUILD_TESTS}")
message(STATUS "  Lua Scripts:  ${VEXEL_ENABLE_LUA}")
message(STATUS "  Web UI:       ${VEXEL_BUILD_WEBUI}")
message(STATUS "  Plugins:      ${VEXEL_BUILD_PLUGINS}")
message(STATUS "═══════════════════════════════════════")
message(STATUS "")
