{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "dev-debug",
      "displayName": "Development (Debug + Phase 1 enabled)",
      "description": "Debug build with Phase 1 audio features enabled for active development",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ZENITH_ENABLE_PHASE1_AUDIO": "ON",
        "ZENITH_ENABLE_CRASH_CAPTURE": "OFF",
        "ZENITH_WARNINGS_AS_ERRORS": "OFF"
      }
    },
    {
      "name": "release-safe",
      "displayName": "Release (Safe - no experimental features)",
      "description": "Release build with all experimental features disabled",
      "inherits": "windows-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ZENITH_ENABLE_PHASE1_AUDIO": "OFF",
        "ZENITH_ENABLE_CRASH_CAPTURE": "OFF",
        "ZENITH_WARNINGS_AS_ERRORS": "ON",
        "ZENITH_LTCG": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug",
      "configuration": "Debug"
    },
    {
      "name": "release-safe",
      "configurePreset": "release-safe",
      "configuration": "Release"
    }
  ]
}
