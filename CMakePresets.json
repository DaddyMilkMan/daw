{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22
  },
  "configurePresets": [
    {
      "name": "dev-debug",
      "displayName": "Dev Debug (Engine ON, HUD ON, Tests ON)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/dev-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ZENITH_ENABLE_PHASE1_AUDIO": "ON",
        "ZENITH_ENABLE_PHASE1_TESTS": "ON",
        "ZENITH_ENABLE_CRASH_CAPTURE": "OFF"
      }
    },
    {
      "name": "release-safe",
      "displayName": "Release Safe (All gates OFF)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/release-safe",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ZENITH_ENABLE_PHASE1_AUDIO": "OFF",
        "ZENITH_ENABLE_PHASE1_TESTS": "OFF",
        "ZENITH_ENABLE_CRASH_CAPTURE": "OFF",
        "ZENITH_LTCG": "ON"
      }
    },
    {
      "name": "dev-release",
      "displayName": "Dev Release (Engine ON, optimized)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/dev-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "ZENITH_ENABLE_PHASE1_AUDIO": "ON",
        "ZENITH_ENABLE_CRASH_CAPTURE": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "dev-debug"
    },
    {
      "name": "release-safe",
      "configurePreset": "release-safe"
    },
    {
      "name": "dev-release",
      "configurePreset": "dev-release"
    }
  ]
}
